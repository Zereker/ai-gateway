{
  "name": "ai-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "preview_urls": true,
  "placement": { "mode": "smart" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-gateway",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "secrets": {
    "required": [
      "PROXY_TOKEN",
      "CONFIG_ENCRYPTION_KEY"
    ]
  },
  // Synced from Cloudflare: the top-level flag is false while collector settings are enabled.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}
