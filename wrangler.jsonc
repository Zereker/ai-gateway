{
  "name": "ai-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ai-gateway",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "secrets": { "required": ["PROXY_TOKEN", "CONFIG_ENCRYPTION_KEY"] }
}
